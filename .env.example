MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/kareers
# openssl rand -base64 48
SESSION_SECRET=
# Vercel sends this as a Bearer token to /api/cron/refresh
CRON_SECRET=
# Classic token, no scopes. Enables contribution calendar + 5000 req/h
GITHUB_TOKEN=
# Used by `npm run seed`
ADMIN_EMAIL=placements@kluniversity.in
ADMIN_PASSWORD=
# Password reset emails over SMTP. For Gmail, SMTP_PASSWORD is a Google App Password (needs 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=passkey.crt@gmail.com
SMTP_PASSWORD=
SMTP_FROM="Kloop <no-reply@kloop.klef.me>"
APP_URL=https://kloop.klef.me
# Kloop Coach (Gemini). Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DAILY_LIMIT=20
